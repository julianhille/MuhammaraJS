{
  "name": "@muhammara/native",
  "version": "7.0.0-alpha.0",
  "description": "HummusJS-compatible native PDF addon with prebuilt binaries",
  "homepage": "https://muhammarajs.readthedocs.io/",
  "license": "Apache-2.0",
  "author": "Julian <j.hille484@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julianhille/MuhammaraJS.git",
    "directory": "packages/native"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "engines": {
    "node": "20 || 22 || 24 || >=25"
  },
  "scripts": {
    "install": "node scripts/install-prebuilt.js",
    "docs:generate": "node ../native-core/scripts/generate-recipe-reference.js && node ../native-core/scripts/generate-declaration-reference.js && prettier --write docs/recipe/reference.md docs/api/type-declarations.md",
    "test:types": "tsc --noEmit --strict --module nodenext --moduleResolution nodenext tests/types.test.ts tests/types-global.test.ts"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "scripts/install-prebuilt.js"
  ],
  "dependencies": {
    "@mapbox/node-pre-gyp": "^2.0.3",
    "@muhammara/native-core": "7.0.0-alpha.0"
  },
  "binary": {
    "module_name": "muhammara",
    "module_path": "./binding",
    "remote_path": "julianhille/MuhammaraJS/releases/download/native-v{version}",
    "host": "https://github.com",
    "package_name": "{node_abi}-{platform}-{arch}-{libc}.tar.gz"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
