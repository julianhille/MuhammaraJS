{
  "name": "@muhammara/wasm",
  "version": "1.1.0",
  "description": "Browser-safe, byte-first WebAssembly API for Muhammara",
  "license": "Apache-2.0",
  "homepage": "https://muhammarajs-wasm.readthedocs.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julianhille/MuhammaraJS.git",
    "directory": "packages/wasm"
  },
  "bugs": {
    "url": "https://github.com/julianhille/MuhammaraJS/issues"
  },
  "type": "module",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./THIRD_PARTY_LICENSES.md": "./dist/THIRD_PARTY_LICENSES.md"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib",
    "fonts",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "DIFFERENCES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "./build.sh",
    "verify": "node ./scripts/run-mocha.mjs tests/integration/EmptyPagesPDF.test.mjs",
    "test": "node ./scripts/run-mocha.mjs 'tests/{*.test.mjs,**/*.test.mjs}'",
    "test:paths": "node ./scripts/check-internal-paths.mjs",
    "test:exports": "node ./scripts/check-exports.mjs",
    "test:manifests": "node ./scripts/check-source-manifests.mjs",
    "test:licenses": "node ./scripts/check-licenses.mjs",
    "test:types": "tsc --noEmit --strict --module nodenext --moduleResolution nodenext tests/types/types.test.ts && tsc --noEmit --strict --lib es2022 --module nodenext --moduleResolution nodenext tests/types/types-node.test.ts",
    "fuzz": "node ./tests/fuzz/fuzz.mjs",
    "docs:generate": "node ./scripts/generate-reference.mjs && prettier --write docs/reference.md",
    "docs:check": "npm run docs:generate && mkdocs build --strict --config-file mkdocs.yml",
    "pages:stage-example": "node ./scripts/stage-pages-example.mjs",
    "pages:index": "node ./scripts/generate-pages-index.mjs",
    "serve:browser": "node ./tests/browser/serve.mjs",
    "server:browser": "npm run serve:browser",
    "test:browser": "node ./tests/browser/run.mjs",
    "test:jsdom": "node ./tests/runtimes/jsdom.mjs",
    "test:deno": "deno run --allow-read ./tests/runtimes/deno.mjs",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "jsdoc-to-markdown": "^9.1.3",
    "jsdom": "^29.1.1",
    "mocha": "^12.0.2",
    "puppeteer-core": "^25.9.0",
    "typescript": "^5.9.3"
  }
}
