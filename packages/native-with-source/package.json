{
  "name": "@muhammara/native-with-source",
  "version": "7.0.0-alpha.0",
  "description": "HummusJS-compatible native PDF addon with C++ source for local Node.js and Electron builds",
  "homepage": "https://muhammarajs.readthedocs.io/",
  "license": "Apache-2.0",
  "author": "Julian <j.hille484@gmail.com>",
  "main": "./index.js",
  "types": "./index.d.ts",
  "engines": {
    "node": "20 || 22 || 24 || >=25"
  },
  "scripts": {
    "install": "node-pre-gyp install --fallback-to-build --jobs=max",
    "test": "node --expose-gc ../../node_modules/mocha/bin/mocha.js --require ./tests/hooks/sanitizer-gc.js -R tap --recursive ./tests --timeout 15000",
    "test:codestyle": "npx prettier -c ./",
    "test:electron": "electron-mocha -R tap --recursive ./tests --timeout 15000",
    "test:types": "tsc --noEmit --strict --module nodenext --moduleResolution nodenext tests/types/types.test.ts",
    "package": "node-pre-gyp package",
    "clean:source": "node scripts/remove-source.js",
    "test:docs": "mocha docs/tests/**/*.js --timeout 15000"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julianhille/MuhammaraJS.git",
    "directory": "packages/native-with-source"
  },
  "keywords": [
    "pdf",
    "pdfhummus",
    "muhammarajs",
    "hummusjs",
    "hummus"
  ],
  "files": [
    "src",
    "scripts/build-openssl.sh",
    "scripts/build-openssl-win.js",
    "scripts/remove-source.js",
    "binding.gyp",
    "openssl.gyp",
    "index.js",
    "index.d.ts",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "dependencies": {
    "@mapbox/node-pre-gyp": "^2.0.3",
    "@muhammara/native-core": "7.0.0-alpha.0"
  },
  "devDependencies": {
    "@types/node": "^22.2.0",
    "chai": "^4.5.0",
    "docdash": "^2.0.1",
    "fs-extra": "^11.2.0",
    "jsdoc": "^4.0.3",
    "jsdoc-to-markdown": "^9.1.3",
    "mocha": "^11.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "tar": "7.5.22"
  },
  "binary": {
    "module_name": "muhammara",
    "module_path": "./binding",
    "remote_path": "julianhille/MuhammaraJS/releases/download/native-v{version}",
    "host": "https://github.com",
    "package_name": "{node_abi}-{platform}-{arch}-{libc}.tar.gz"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "muhammara-clean-source": "scripts/remove-source.js"
  },
  "bundleDependencies": []
}
